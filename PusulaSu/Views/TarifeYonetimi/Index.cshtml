@model List<PusulaSu.Models.Tarife>

@{
    ViewData["Title"] = "Tarife Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Tarife Yönetimi</h1>
        <p class="text-muted mb-0">
            Su ve atıksu tarifelerini yönetin.
        </p>
    </div>

    <a asp-action="Ekle" class="btn btn-primary">
        + Yeni Tarife Ekle
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="p-3">Dönem</th>
                        <th>Abone Türü</th>
                        <th>Alt Sınır</th>
                        <th>Üst Sınır</th>
                        <th>Su Fiyatı</th>
                        <th>Atıksu Fiyatı</th>
                        <th class="text-end p-3">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var tarife in Model)
                    {
                        <tr>
                            <td class="p-3">
                                <span class="badge bg-light text-dark border">
                                    @tarife.Ay.ToString("D2")/@tarife.Yil
                                </span>
                            </td>

                            <td>@tarife.AboneTuru</td>
                            <td>@tarife.AltSinir.ToString("0.##") m³</td>

                            <td>
                                @(tarife.UstSinir.HasValue
                                    ? $"{tarife.UstSinir.Value:0.##} m³"
                                    : "Sınırsız")
                            </td>

                            <td>
                                @tarife.SuBirimFiyati.ToString("N2") TL
                            </td>

                            <td>
                                @tarife.AtikSuBirimFiyati.ToString("N2") TL
                            </td>

                            <td class="text-end p-3">
                                <a asp-action="Duzenle"
                                   asp-route-id="@tarife.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    Düzenle
                                </a>

                                <form asp-action="Sil"
                                      asp-route-id="@tarife.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu tarifeyi silmek istediğinize emin misiniz?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>